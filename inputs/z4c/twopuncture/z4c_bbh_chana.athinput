<comment>
problem = equal-mass quasicircular Bowen-York binary (Hannam et al. 2010 data),
          matched to chana's binary_puncture run for a puncture-track
          comparison.  Build with -D PROBLEM=z4c_two_puncture; see
          README_chana_bbh.md beside this file.
          Units: G = c = M = 1.  chana ran the same data at M = 3.0e5 cm, so
          chana lengths / 3.0e5 cm and chana times / 1.00069228559445614e-05 s
          give the numbers here.
          Grid from that run's dumps: domain +-96 M, 7^3 root blocks of 8^3
          cells, max level 7 (dx_min = 0.02679 M), 6th-order Z4c in both codes.
          Known differences from chana: RK4 at cfl 0.25 (chana: eSSPRK(10,4)
          at dt = 0.84 dx_min); AthenaK derefines below dchi_max/2 (chana never
          derefines); this AthenaK has no chi floor (chana: floor_chi at 1e-12).

<job>
basename  = bbh

<mesh>
nghost    = 4          # 6th-order stencils, as chana's
nx1       = 56         # 7 root blocks x 8 cells
x1min     = -96.0
x1max     = 96.0
ix1_bc    = outflow
ox1_bc    = outflow
nx2       = 56
x2min     = -96.0
x2max     = 96.0
ix2_bc    = outflow
ox2_bc    = outflow
nx3       = 56
x3min     = -96.0
x3max     = 96.0
ix3_bc    = outflow
ox3_bc    = outflow

<meshblock>
nx1       = 8
nx2       = 8
nx3       = 8

<time>
evolution  = dynamic
integrator = rk4
cfl_number = 0.25      # dt = cfl * dx_min = 0.0067 M -> ~5500 cycles to tlim
nlim       = -1
tlim       = 37.0      # chana's tracker ends at t = 37.33 M; the figure is at t = 36 M
ndiag      = 1

<mesh_refinement>
refinement          = adaptive
num_levels          = 8          # root + 7 (chana max_level = 7)
max_nmb_per_rank    = 16000      # PREALLOCATED: ~3.1 MB per 8^3 block with 4 ghosts, so ~50 GB.
                                 # The run starts at 12236 blocks; lower this only if the
                                 # device has less memory, and raise it if AMR exceeds it.
ncycle_check        = 4          # chana amr_interval = 4
refinement_interval = 4

<z4c_amr>
method   = dchi                  # same undivided |grad chi| indicator as chana's z4c_dchi
dchi_max = 0.03                  # chana amr_refine_thresh

# AthenaK refines only during evolution, one level per check, so start with the
# punctures already at the finest level as chana does (~2.5 M across each).
<refinement1>
level = 7
x1min = 4.82
x1max = 7.39
x2min = -1.29
x2max = 1.29
x3min = -1.29
x3max = 1.29

<refinement2>
level = 7
x1min = -7.39
x1max = -4.82
x2min = -1.29
x2max = 1.29
x3min = -1.29
x3max = 1.29

<z4c>
lapse_oplog     = 2.0
lapse_harmonic  = 0.0
shift_Gamma     = 1.0
shift_eta       = 2.1            # chana 7e-6 /cm * 3e5 cm
damp_kappa1     = 0.06           # chana 2e-7 /cm * 3e5 cm
damp_kappa2     = 0.0
diss            = 0.5
chi_div_floor   = 1.0e-5
nrad_wave_extraction = 0

co_0_type = BH                   # writes bbh.co_0.txt: iter, t, x, y, z, vx, vy, vz
co_0_x    = 6.10679
co_0_y    = 0.0
co_0_z    = 0.0
co_1_type = BH
co_1_x    = -6.10679
co_1_y    = 0.0
co_1_z    = 0.0

<problem>
verbose     = true
par_b       = 6.10679
par_m_plus  = 0.488479
par_m_minus = 0.488479
give_bare_mass = true
par_P_plus1  = -5.10846e-4
par_P_plus2  = 8.41746e-2
par_P_plus3  = 0.0
par_P_minus1 = 5.10846e-4
par_P_minus2 = -8.41746e-2
par_P_minus3 = 0.0
par_S_plus1  = 0.0
par_S_plus2  = 0.0
par_S_plus3  = 0.0
par_S_minus1 = 0.0
par_S_minus2 = 0.0
par_S_minus3 = 0.0
center_offset1 = 0.0
center_offset2 = 0.0
center_offset3 = 0.0
npoints_A   = 30
npoints_B   = 30
npoints_phi = 16
Newton_tol  = 1e-10
Newton_maxit = 5
TP_epsilon  = 0.0
TP_Tiny     = 0.0
TP_Extend_Radius = 0
adm_tol     = 1e-10
do_residuum_debug_output = false
solve_momentum_constraint = false
initial_lapse_psi_exponent = -2.0     # chana: alpha = psi^-2
swap_xz     = false
